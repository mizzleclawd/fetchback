# Frontend (Vite) — filled automatically by `convex dev` into .env.local
VITE_CONVEX_URL=

# Deployment env vars — set via `bunx convex env set NAME value`, never committed:
#   OPENAI_API_KEY          — OpenAI key with vision access
#   OPENAI_MODEL            — optional, defaults to gpt-5.2
#   AGENTMAIL_API_KEY       — AgentMail API key
#   AGENTMAIL_WEBHOOK_SECRET— from AgentMail webhook registration
#   AGENTMAIL_INBOX_ID      — the case inbox id
#   FIRECRAWL_API_KEY       — Firecrawl key ($20k hackathon credits)
#   FIRECRAWL_WEBHOOK_SECRET— optional, webhook-mode crawls
